{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "python -m h2h.migrate",
    "startCommand": "timeout 20m python -m h2h.archive.lifecycle_entrypoint",
    "restartPolicyType": "NEVER",
    "cronSchedule": "40 2 * * *",
    "numReplicas": 1
  }
}
