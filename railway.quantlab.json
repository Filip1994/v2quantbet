{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "preDeployCommand": "python -m h2h.migrate",
    "startCommand": "timeout 8m python -m h2h.quantlab.entrypoint",
    "healthcheckPath": "/livez",
    "healthcheckTimeout": 120,
    "restartPolicyType": "NEVER",
    "cronSchedule": "0 */12 * * *",
    "numReplicas": 1
  }
}
