# Local development only. Never commit real values.
APP_ENV=production
LOG_LEVEL=INFO

# Add real provider/database secrets only through local environment
# or Railway variables. These names are placeholders for now.
API_FOOTBALL_KEY=
DATABASE_URL=

# Single-service production runtime. Fixture eligibility is governed by the
# Phase I competition policy, not an explicit league or fixture allowlist.
QUANTBET_BOOKMAKER_ID=8
QUANTBET_BANKROLL_BOOTSTRAP_MODE=verify
QUANTBET_DISCOVERY_INTERVAL_SECONDS=900
QUANTBET_DISCOVERY_LOOKAHEAD_HOURS=72
QUANTBET_OPPORTUNITY_INTERVAL_SECONDS=60
QUANTBET_OPPORTUNITY_MAX_ITEMS=10
QUANTBET_OPPORTUNITY_MAX_WALL_SECONDS=30
# Dixon-Coles coverage runs as an independent fair scheduler job. It uses at
# most one scope, two provider attempts and 45 seconds per cycle.
QUANTBET_MODEL_TRAINING_INTERVAL_SECONDS=60
QUANTBET_MODEL_TRAINING_MAX_SCOPES=1
QUANTBET_MODEL_TRAINING_MAX_PROVIDER_REQUESTS=2
QUANTBET_MODEL_TRAINING_MAX_WALL_SECONDS=45
QUANTBET_MODEL_TRAINING_DAILY_REQUEST_LIMIT=25
# Capacity inside the effective provider budget that training may never consume.
QUANTBET_MODEL_TRAINING_OPERATIONAL_RESERVE=500
# Half-open [reference-730d, reference) window. reference is 00:00 UTC on the
# cycle day, so no same-day/future result can enter a fit. Target season is tried
# first, then one prior season for early-season coverage.
QUANTBET_MODEL_HISTORY_WINDOW_DAYS=730
QUANTBET_MODEL_MIN_MATCHES=80
QUANTBET_MODEL_XI=0.0018
QUANTBET_MODEL_RIDGE=0.01
QUANTBET_MODEL_FRESHNESS_DAYS=14
QUANTBET_MODEL_PREVIOUS_SEASONS=1
QUANTBET_MODEL_MIN_TEAM_MATCHES=3
QUANTBET_SCHEDULER_TICK_SECONDS=5
QUANTBET_SHUTDOWN_GRACE_SECONDS=30
QUANTBET_API_DAILY_LIMIT=7500
QUANTBET_API_RESERVE=1500
QUANTBET_API_TIMEOUT_SECONDS=10
QUANTBET_DATABASE_STARTUP_ATTEMPTS=12
QUANTBET_DATABASE_STARTUP_BACKOFF_SECONDS=5
PORT=8080

# Task #10 registration policy. Money is integer minor units (RSD para).
QUANTBET_ALLOWED_MARKET_SELECTIONS=OU_25/OVER,OU_25/UNDER,BTTS/YES,BTTS/NO
QUANTBET_ALLOWED_DEVIG_METHODS=PROPORTIONAL_TWO_WAY_V1
# Required exact API-Football status allowlist; set only after operational approval.
QUANTBET_ALLOWED_FIXTURE_STATUSES=
QUANTBET_MINIMUM_EDGE=0.03
QUANTBET_MINIMUM_EXPECTED_VALUE=0.02
QUANTBET_MINIMUM_ODDS=1.40
QUANTBET_MAXIMUM_ODDS=3.50
QUANTBET_MAXIMUM_QUOTE_AGE_SECONDS=300
QUANTBET_MINIMUM_TIME_TO_KICKOFF_SECONDS=600
QUANTBET_BANKROLL_ACCOUNT_ID=quantbet-pilot-rsd
QUANTBET_CURRENCY=RSD
QUANTBET_INITIAL_BANKROLL_MINOR=3000000
QUANTBET_FIXED_STAKE_MINOR=30000
QUANTBET_MAX_STAKE_PER_PICK_MINOR=30000
QUANTBET_MAX_OPEN_EXPOSURE_MINOR=300000

# Task #11 pick-monitoring lifecycle. All duration values are explicit seconds.
QUANTBET_PICK_MONITOR_INTERVAL_SECONDS=
QUANTBET_CURRENT_MAX_AGE_SECONDS=
QUANTBET_CLOSING_MAX_AGE_SECONDS=
QUANTBET_BULLETIN_TIMEZONE=Europe/Belgrade

# Task #12 result acquisition and settlement. Defaults shown explicitly.
QUANTBET_RESULT_INITIAL_DELAY_SECONDS=6300
QUANTBET_RESULT_POLL_INTERVAL_SECONDS=300
QUANTBET_RESULT_SUSPENDED_POLL_INTERVAL_SECONDS=900
QUANTBET_RESULT_POSTPONED_POLL_INTERVAL_SECONDS=21600
QUANTBET_RESULT_FINALITY_DELAY_SECONDS=900
QUANTBET_RESULT_CLAIM_LEASE_SECONDS=120
QUANTBET_RESULT_CLAIM_LIMIT=100
QUANTBET_RESULT_CORRECTION_WINDOW_SECONDS=259200
